    "esi:update": "node scripts/esi/update.ts",
    "data:update": "node scripts/data/update.ts",
    "data:verify": "node scripts/data/verify.ts",
    "data:publish": "node scripts/data/publish.ts",
    "data:rollback": "node scripts/data/rollback.ts",
    "pyfa:check": "node scripts/pyfa/check.ts"
  },
  "dependencies": {
    "eve-fit-engine": "0.2.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.13.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
